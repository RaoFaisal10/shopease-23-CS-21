rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Continue the Assignment 1 profile behavior.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Store catalog is created by the project owner in Firebase Console.
    match /products/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Each signed-in user can access only their own cart documents.
    match /carts/{uid}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Customers create and read their own orders, not someone else's.
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
