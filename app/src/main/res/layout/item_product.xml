<com.google.android.material.card.MaterialCardView
 xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_margin="6dp" android:clickable="true" android:focusable="true"
 android:foreground="?attr/selectableItemBackground"
 app:cardBackgroundColor="@color/white" app:cardCornerRadius="20dp"
 app:strokeWidth="1dp" app:strokeColor="@color/stroke_soft" app:cardElevation="0dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <FrameLayout android:layout_width="match_parent" android:layout_height="148dp" android:background="@color/pale_orange">
    <ImageView android:id="@+id/ivProduct" android:layout_width="match_parent"
      android:layout_height="match_parent" android:scaleType="centerCrop"
      android:contentDescription="Product photograph"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_gravity="top|start" android:layout_margin="11dp"
      android:background="@drawable/bg_a2_tag" android:paddingHorizontal="11dp" android:paddingVertical="6dp"
      android:text="SHOP EASE" android:textColor="@color/ink"
      android:fontFamily="sans-serif-bold" android:textSize="9sp" android:letterSpacing="0.11"/>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:paddingLeft="12dp" android:paddingRight="12dp"
      android:paddingTop="12dp" android:paddingBottom="13dp">
    <TextView android:id="@+id/tvProductCategory" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="@color/accent_deep" android:textSize="9sp" android:fontFamily="sans-serif-bold"
      android:letterSpacing="0.1" android:maxLines="1"/>
    <TextView android:id="@+id/tvProductTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="6dp" android:minHeight="38dp" android:maxLines="2" android:ellipsize="end"
      android:textColor="@color/ink" android:fontFamily="sans-serif-bold" android:textSize="15sp"/>
    <TextView android:id="@+id/tvProductPrice" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="4dp" android:textColor="@color/brand_navy" android:fontFamily="sans-serif-black"
      android:textSize="17sp"/>
    <TextView android:id="@+id/tvProductStock" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="8dp" android:textColor="@color/success"
      android:fontFamily="sans-serif-bold" android:textSize="9sp" android:letterSpacing="0.09"/>
  </LinearLayout>
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
