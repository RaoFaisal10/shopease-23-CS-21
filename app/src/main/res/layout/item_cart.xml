<com.google.android.material.card.MaterialCardView
 xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp"
 android:layout_marginBottom="12dp" app:cardCornerRadius="20dp" app:cardBackgroundColor="@color/white"
 app:strokeWidth="1dp" app:strokeColor="@color/stroke_soft" app:cardElevation="0dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
  <ImageView android:id="@+id/ivImage" android:layout_width="92dp" android:layout_height="105dp"
     android:background="@drawable/bg_a2_item" android:scaleType="centerCrop" android:contentDescription="Cart product"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
      android:layout_marginStart="14dp" android:orientation="vertical">
     <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
       android:maxLines="2" android:ellipsize="end" android:fontFamily="sans-serif-bold"
       android:textSize="15sp" android:textColor="@color/ink"/>
     <TextView android:id="@+id/tvUnitPrice" android:layout_width="wrap_content" android:layout_height="wrap_content"
       android:layout_marginTop="3dp" android:textSize="11sp" android:textColor="@color/muted"/>
     <TextView android:id="@+id/tvLineTotal" android:layout_width="wrap_content" android:layout_height="wrap_content"
       android:layout_marginTop="6dp" android:fontFamily="sans-serif-black" android:textSize="16sp" android:textColor="@color/brand_navy"/>
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="9dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="40dp"
           android:background="@drawable/bg_a2_qty" android:gravity="center_vertical" android:orientation="horizontal">
          <com.google.android.material.button.MaterialButton android:id="@+id/btnMinus"
           style="@style/ShopQuantityButton" android:layout_width="38dp" android:layout_height="38dp"
           android:text="−" android:textSize="18sp" android:minWidth="0dp" android:textColor="@color/ink"/>
          <TextView android:id="@+id/tvQty" android:layout_width="22dp" android:layout_height="wrap_content"
           android:gravity="center" android:text="1" android:textSize="13sp" android:fontFamily="sans-serif-bold" android:textColor="@color/ink"/>
          <com.google.android.material.button.MaterialButton android:id="@+id/btnPlus"
           style="@style/ShopQuantityButton" android:layout_width="38dp" android:layout_height="38dp"
           android:text="+" android:textSize="18sp" android:minWidth="0dp" android:textColor="@color/ink"/>
        </LinearLayout>
        <TextView android:id="@+id/tvRemove" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
           android:paddingStart="10dp" android:gravity="end|center_vertical" android:text="Remove"
           android:clickable="true" android:focusable="true" android:textColor="@color/coral"
           android:textSize="12sp" android:fontFamily="sans-serif-bold"/>
     </LinearLayout>
  </LinearLayout>
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
